  create view "dev"."main"."int_clientes_com_endereco__dbt_tmp" as (
    with clientes as (
    select *
    from "dev"."main"."stg_cliente"
),

enderecos as (
    select *
    from "dev"."main"."stg_endereco"
),

joined as (
    select
        c.cliente_id,
        c.nome_cliente,
        c.email,
        c.dt_cadastro,
        c.status_cliente,
        c.segmento,
        c.canal_preferido,
        c.score_fidelidade,
        e.endereco_id,
        e.uf,
        e.cidade,
        e.cep,
        e.logradouro,
        e.bairro,
        e.numero,
        e.complemento
    from clientes c
    left join enderecos e
        on c.cliente_id = e.cliente_id
